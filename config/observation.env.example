# ═══════════════════════════════════════════════════════════════════════════
#         FENRIR — READ-ONLY OBSERVATION WINDOW (empirical phase)
# ═══════════════════════════════════════════════════════════════════════════
#
# Purpose: run the bot in SIMULATION against the LIVE read feeds to gather real
# data — WITHOUT risking any capital — so the backtester can quantify whether the
# strategies and confluence actually have an edge.
#
# What this does (all read-only):
#   • observes real pump.fun launches (live Geyser/WebSocket feed)
#   • routes them through the multi-agent pipeline + momentum/mean_reversion
#   • paper-trades in SIMULATION (no real transactions)
#   • COLLECTS each flagged token's forward price path to a JSONL file
#   • SURFACES multi-strategy confluence as events
#   • MONITORS graduated tokens for cross-pool arbitrage divergence
#
# How to use:
#   1. Keep your existing .env (RPC/Geyser/AI read-credentials live there).
#   2. Append the toggles below to that .env (or export them in your shell).
#   3. Run the bot and LEAVE IT for a window (hours→days) so real launches accrue.
#   4. Analyze:
#        python -m tools.signal_backtest \
#            --samples backtest_samples.jsonl \
#            --strategies momentum,mean_reversion --min-sources 2
#
# SAFETY: MODE=simulation means NO SOL is ever spent. Every instrument below is
# read-only. Do NOT set MODE=degen/aggressive/conservative for the observation run.
# ═══════════════════════════════════════════════════════════════════════════

# Paper-trade only — no real transactions.
MODE=simulation

# The two ready directional strategies (both off-by-default otherwise).
ENABLED_STRATEGIES=momentum,mean_reversion

# The pipeline is already the default; set explicitly for clarity.
MULTI_AGENT_PIPELINE_ENABLED=true

# ── Forward-price sample collection → backtester fuel ──────────────────────
SAMPLE_COLLECTION_ENABLED=true
SAMPLE_COLLECTION_PATH=backtest_samples.jsonl
SAMPLE_COLLECTION_FRAMES=30          # price samples per flagged token
SAMPLE_COLLECTION_FRAME_SECONDS=60   # spacing between samples (→ 30 min of forward path)

# ── Signal confluence surfacing (read-only events) ─────────────────────────
SIGNAL_CONFLUENCE_ENABLED=true
SIGNAL_CONFLUENCE_MIN_SOURCES=2

# ── Cross-pool arbitrage monitor (read-only events) ────────────────────────
ARBITRAGE_MONITOR_ENABLED=true
ARBITRAGE_MIN_NET_EDGE_BPS=50        # flag only edges that clear round-trip cost
ARBITRAGE_SIZE_SOL=0.1               # notional the net-edge is estimated for
ARBITRAGE_INTERVAL_SECONDS=30

# Optional: also evaluate launches no strategy claimed (uses the AI scout — costs
# AI credits). Leave off for a pure strategy-signal collection run.
# AI_EVALUATE_ALL_LAUNCHES=false
